#!/bin/bash
# =============================================================================
# Instruqt preset setup — Temporal Cloud Platform Workshop (6 sessions)
#
# Builds the environment PREREQUISITES.md asks attendees to build on their own
# laptop, so nobody spends the morning on installs or waiting for a firewall
# change. Everything here is what that document lists as required:
#
#   Temporal CLI                  every session
#   temporal cloud extension      Sessions 1, 2   (a SEPARATE binary)
#   Terraform 1.5+                Sessions 1, 2
#   Python 3.12 + uv              Sessions 1, 3, 4, 5, 6   (labs/worker)
#   Docker + Compose              Sessions 4, 5
#   temporalio/temporal-proxy     Session 4
#   Prometheus + Grafana images   Session 5
#   git clone of the lab repo     all sessions
#
# ONE worker toolchain: Python 3.12 via uv. The lab repo's C# worker is gone and
# so is the dual-stack machinery that carried the migration — no .NET SDK, no
# WORKER_STACK knob, no /etc/workshop-stack. A fetched labs/worker without a
# pyproject.toml now fails the build rather than falling back to anything, which
# is the honest failure: there is no second stack left to fall back to.
#
# The VM opens `high-ports` in config.yml; the track's assignment.md turns these
# into service tabs:
#
#   8443  code-server (https, no auth)   ← the student's editor and terminal
#   3030  Grafana        (Session 5)
#   9090  Prometheus     (Session 5)
#   9464  worker SDK metrics (Session 5, optional — Prometheus scrapes it
#         internally via host.docker.internal, so only expose it if you want
#         students curling /metrics from a browser)
#   8233  local dev-server UI (fallback only — the service ships DISABLED,
#         see "Local dev server" below for why)
#
# Everything the labs touch outbound is what PREREQUISITES.md lists:
# *.tmprl.cloud:7233, saas-api.tmprl.cloud:443, cloud.temporal.io:443, the
# training portal, registry.terraform.io, pypi.org, *.docker.io,
# github.com. (github.com is also where uv fetches its managed CPython build
# from — astral-sh/python-build-standalone — so it is not only the lab repo.)
# The final health check probes the two that matter and fails loudly — set
# WORKSHOP_STRICT_EGRESS=0 to downgrade that to a warning if the *build* network
# differs from the sandbox network.
# =============================================================================
set -euxo pipefail

# ─── Bootstrap sentinel ───────────────────────────────────────────────────────
# Setup runs as soon as the host is allocated, which can be before the Instruqt
# agent has finished bootstrapping it. Everything below — apt, systemd, docker —
# races that if it starts early.
until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    sleep 1
done

# ─── Versions and knobs ───────────────────────────────────────────────────────
# Override any of these from the Instruqt track config.

# The repo holding labs/ — Terraform files, the Python worker, the proxy config
# and the observability stack. LAB_REPO_TOKEN arrives as an Instruqt secret, never
# from config.yml's environment block; tr strips the carriage return a token
# pasted from Windows carries into the UI.
LAB_REPO_URL="${LAB_REPO_URL:-https://github.com/taonic/temporal-cloud-training-portal.git}"
LAB_REPO_REF="${LAB_REPO_REF:-taonic/python}"
set +x   # xtrace would print the token into the Instruqt setup log
LAB_REPO_TOKEN="$(printf '%s' "${LAB_REPO_TOKEN:-}" | tr -d '\r\n')"
set -x

WORKSHOP_DIR="${WORKSHOP_DIR:-/workspace/workshop}"

# Pinned deliberately: a workshop that installs "latest" is a workshop that
# breaks on a morning when someone else cut a release. Every version below is a
# tag, never a `latest` redirect, and every download that publishes a checksum
# is verified against it.
TEMPORAL_CLI_VERSION="${TEMPORAL_CLI_VERSION:-1.8.2}"
TERRAFORM_VERSION="${TERRAFORM_VERSION:-1.15.8}"
# uv is the only Python toolchain here: it installs the interpreter, resolves the
# lockfile and runs the worker. No apt python3, no deadsnakes PPA, no pip, no
# venv the student has to remember to activate.
UV_VERSION="${UV_VERSION:-0.12.5}"
# Must match labs/worker/.python-version, which is what `uv sync` actually reads.
# Pinned here as well so the interpreter is downloaded at build time rather than
# at 09:05 in front of the room.
PYTHON_VERSION="${PYTHON_VERSION:-3.12}"
COMPOSE_VERSION="${COMPOSE_VERSION:-v5.4.0}"

CODE_SERVER_VERSION="${CODE_SERVER_VERSION:-4.131.0}"
# The Cloud extension is Pre-release and Homebrew-only in the docs. It also
# publishes plain Linux tarballs, which is the path used here — no brew, no Go
# toolchain. See https://github.com/temporalio/cloud-cli/releases
CLOUD_CLI_VERSION="${CLOUD_CLI_VERSION:-0.0.3}"

# Must match labs/observability/docker-compose.yml, or the pre-pull warms the
# wrong tags and students pull at 09:15 anyway.
PROMETHEUS_IMAGE="${PROMETHEUS_IMAGE:-prom/prometheus:v3.1.0}"
GRAFANA_IMAGE="${GRAFANA_IMAGE:-grafana/grafana:11.5.1}"
PROXY_IMAGE="${PROXY_IMAGE:-temporalio/temporal-proxy:v0.4.1}"

# The Temporal Cloud account students are invited into. Session 4's proxy needs
# it as a bare account id (it appends it to the short namespace name).
TEMPORAL_ACCOUNT="${TEMPORAL_ACCOUNT:-bvmon}"

# 1: a blocked egress path fails the preset build. 0: it only warns, and the
# student finds out from `workshop-check` instead.
WORKSHOP_STRICT_EGRESS="${WORKSHOP_STRICT_EGRESS:-1}"

DPKG_ARCH="$(dpkg --print-architecture)"   # amd64 | arm64
case "$DPKG_ARCH" in
    amd64) COMPOSE_ARCH=x86_64  ; UV_TARGET=x86_64-unknown-linux-gnu ;;
    arm64) COMPOSE_ARCH=aarch64 ; UV_TARGET=aarch64-unknown-linux-gnu ;;
    *) echo "ERROR: unsupported architecture $DPKG_ARCH"; exit 1 ;;
esac

# Everything the labs write — the clone, the dev-server db, its log — lives here.
mkdir -p /workspace

# Verify a downloaded file against a published checksum manifest. Every release
# used here ships one, so nothing installs unverified — a mirror serving a
# different binary fails the build rather than the workshop.
#
#   verify_sha256 <file> <checksums-url> <name-in-manifest>
verify_sha256() {
    local file="$1" manifest_url="$2" name="$3" expected
    curl -fsSL -o /tmp/checksums.txt "$manifest_url"
    expected="$(awk -v n="$name" '$2 == n || $2 == "*" n { print $1 }' /tmp/checksums.txt | head -1)"
    rm -f /tmp/checksums.txt
    if [ -z "$expected" ]; then
        echo "ERROR: $name has no entry in $manifest_url"
        exit 1
    fi
    echo "${expected}  ${file}" | sha256sum -c -
}

# ─── Base packages ────────────────────────────────────────────────────────────
export DEBIAN_FRONTEND=noninteractive

# netcat-openbsd: the `nc -z` egress checks below, and the one PREREQUISITES.md
# asks attendees to run.
#
# Nothing here is for Python. uv's managed CPython is a self-contained build
# (astral-sh/python-build-standalone) and needs no libpython, no build-essential
# and no -dev headers — which is why the whole worker toolchain is one download
# rather than an apt tree.
apt-get update && apt-get install -y --no-install-recommends \
    wget curl git vim nano unzip zip jq ca-certificates gnupg \
    bash-completion netcat-openbsd dnsutils fontconfig

# ─── Temporal CLI ─────────────────────────────────────────────────────────────
# The release tarball rather than `curl https://temporal.download/cli.sh | sh`:
# the installer resolves to whatever is current and there is nothing to check it
# against. /root/.temporalio/bin is still the install location, because the
# systemd units and ~/.bashrc below put it on PATH.
TEMPORAL_CLI_TGZ="temporal_cli_${TEMPORAL_CLI_VERSION}_linux_${DPKG_ARCH}.tar.gz"
curl -fsSL -o /tmp/temporal-cli.tgz \
    "https://github.com/temporalio/cli/releases/download/v${TEMPORAL_CLI_VERSION}/${TEMPORAL_CLI_TGZ}"
verify_sha256 /tmp/temporal-cli.tgz \
    "https://github.com/temporalio/cli/releases/download/v${TEMPORAL_CLI_VERSION}/checksums.txt" \
    "$TEMPORAL_CLI_TGZ"

mkdir -p /root/.temporalio/bin
tar -xzf /tmp/temporal-cli.tgz -C /root/.temporalio/bin temporal
rm -f /tmp/temporal-cli.tgz
chmod +x /root/.temporalio/bin/temporal
ln -sf /root/.temporalio/bin/temporal /usr/local/bin/temporal
export PATH="$PATH:/root/.temporalio/bin:/usr/local/bin"

temporal --version

# ─── Temporal Cloud extension ─────────────────────────────────────────────────
# A SEPARATE install from the CLI, and the single most common thing attendees
# arrive without. The `temporal` CLI discovers `temporal-cloud` on PATH and
# exposes it as `temporal cloud …`.
CLOUD_CLI_TGZ="temporal_cloud_cli_${CLOUD_CLI_VERSION}_linux_${DPKG_ARCH}.tar.gz"
curl -fsSL -o /tmp/temporal-cloud.tgz \
    "https://github.com/temporalio/cloud-cli/releases/download/v${CLOUD_CLI_VERSION}/${CLOUD_CLI_TGZ}"
verify_sha256 /tmp/temporal-cloud.tgz \
    "https://github.com/temporalio/cloud-cli/releases/download/v${CLOUD_CLI_VERSION}/checksums.txt" \
    "$CLOUD_CLI_TGZ"

tar -xzf /tmp/temporal-cloud.tgz -C /tmp temporal-cloud
install -m 0755 /tmp/temporal-cloud /usr/local/bin/temporal-cloud
rm -f /tmp/temporal-cloud.tgz /tmp/temporal-cloud

temporal cloud --help > /dev/null

# ─── Terraform ────────────────────────────────────────────────────────────────
TERRAFORM_ZIP="terraform_${TERRAFORM_VERSION}_linux_${DPKG_ARCH}.zip"
curl -fsSL -o /tmp/terraform.zip \
    "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/${TERRAFORM_ZIP}"
verify_sha256 /tmp/terraform.zip \
    "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_SHA256SUMS" \
    "$TERRAFORM_ZIP"

unzip -o -d /usr/local/bin /tmp/terraform.zip
rm -f /tmp/terraform.zip
chmod +x /usr/local/bin/terraform

terraform version

# ─── Python 3.12 via uv ───────────────────────────────────────────────────────
# The worker toolchain, and the only one. Installed before the lab repo is
# fetched, because the fetch is what decides nothing here — there is one stack.
#
# The release tarball at a pinned version, not `curl astral.sh/uv/install.sh | sh`
# — same reasoning as the Temporal CLI above, and the installer would drop uv in
# /root/.local/bin where the code-server unit's explicit PATH cannot see it.
#
# Every uv asset ships its own <asset>.sha256, whose contents are already in
# `<hash>  <name>` form, so verify_sha256 takes it unchanged.
#
# Both binaries: `uv` runs the labs, and `uvx` is what a student reaches for to
# try a tool without installing it. Costs nothing to have the second one.
UV_TGZ="uv-${UV_TARGET}.tar.gz"
curl -fsSL -o /tmp/uv.tgz \
    "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${UV_TGZ}"
verify_sha256 /tmp/uv.tgz \
    "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/${UV_TGZ}.sha256" \
    "$UV_TGZ"

tar -xzf /tmp/uv.tgz -C /tmp
install -m 0755 "/tmp/uv-${UV_TARGET}/uv"  /usr/local/bin/uv
install -m 0755 "/tmp/uv-${UV_TARGET}/uvx" /usr/local/bin/uvx
rm -rf /tmp/uv.tgz "/tmp/uv-${UV_TARGET}"

# Both paths are pinned rather than left at the ~/.local/share/uv default, because
# the code-server unit below runs with an explicit environment: a path that depends
# on $HOME resolves differently in a systemd-launched terminal than in the shell
# this build script uses, and the symptom is uv re-downloading CPython the first
# time a student runs the worker — the exact wait this pre-warm exists to remove.
# They are also set in /etc/environment, ~/.bashrc and that unit, all three.
#
# The cache goes under /workspace, NOT /opt, and that is not arbitrary. uv
# hardlinks wheels out of the cache into the venv, which only works within one
# filesystem — and the venv is at $WORKSHOP_DIR/labs/worker/.venv, under
# /workspace. Put the cache on a different mount and every install silently
# degrades to a full copy with a warning attached, on every student's first run.
# /workspace/.uv-cache is a sibling of $WORKSHOP_DIR rather than inside it, so it
# stays out of the tree code-server opens.
export UV_PYTHON_INSTALL_DIR=/opt/uv/python
export UV_CACHE_DIR=/workspace/.uv-cache
# only-managed, not the default `managed`: the base image carries its own
# python3, and "whichever interpreter uv happened to find" is not a thing to
# leave loose in a workshop where a wrong minor version is a debugging session.
export UV_PYTHON_PREFERENCE=only-managed
mkdir -p "$UV_PYTHON_INSTALL_DIR" "$UV_CACHE_DIR"

uv --version
# --no-bin: do NOT drop python3.12 shims into ~/.local/bin. Two reasons — the
# build log stops carrying uv's "`/root/.local/bin` is not on your PATH" warning,
# and more importantly a bare `python3.12` on a student's PATH is an interpreter
# with no temporalio in it. Every lab command goes through `uv run`, which uses
# labs/worker/.venv; an interpreter that looks right and cannot import the SDK is
# a debugging session nobody signed up for.
uv python install --no-bin "$PYTHON_VERSION"
uv python list --only-installed

# ─── Docker + Compose ─────────────────────────────────────────────────────────
# The instruqt/docker-* base images ship it; install if this preset is retargeted
# at a plain Ubuntu image.
if ! command -v docker > /dev/null 2>&1; then
    curl -fsSL https://get.docker.com | sh
fi

systemctl start docker || true

for i in $(seq 1 30); do
    if docker info > /dev/null 2>&1; then break; fi
    if [ "$i" -eq 30 ]; then echo "ERROR: docker daemon never became available"; exit 1; fi
    sleep 2
done

# Session 5 runs `docker compose up -d`. The v1 `docker-compose` shim is not
# enough — the compose file uses `${GRAFANA_PORT:-3030}` interpolation.
if ! docker compose version > /dev/null 2>&1; then
    mkdir -p /usr/local/lib/docker/cli-plugins
    COMPOSE_BIN="docker-compose-linux-${COMPOSE_ARCH}"
    curl -fsSL -o /tmp/docker-compose \
        "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/${COMPOSE_BIN}"
    verify_sha256 /tmp/docker-compose \
        "https://github.com/docker/compose/releases/download/${COMPOSE_VERSION}/checksums.txt" \
        "$COMPOSE_BIN"
    install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
    rm -f /tmp/docker-compose
fi

docker compose version

# ─── Pre-pull lab images ──────────────────────────────────────────────────────
# Twenty people pulling Grafana at 14:30 is fifteen minutes of the session.
# Independent downloads, so run them together rather than end to end.
docker pull "$PROXY_IMAGE" &      PID_PROXY=$!
docker pull "$PROMETHEUS_IMAGE" & PID_PROM=$!
docker pull "$GRAFANA_IMAGE" &    PID_GRAF=$!

wait $PID_PROXY || { echo "ERROR: could not pull $PROXY_IMAGE"; exit 1; }
wait $PID_PROM  || { echo "ERROR: could not pull $PROMETHEUS_IMAGE"; exit 1; }
wait $PID_GRAF  || { echo "ERROR: could not pull $GRAFANA_IMAGE"; exit 1; }

# labs/proxy/README.md still says `temporalio/temporal-proxy:latest`. Tag the
# pinned image as latest locally so a student who copies that line out of the
# README gets the cached image instead of a fresh — and different — pull.
docker tag "$PROXY_IMAGE" temporalio/temporal-proxy:latest

# ─── Lab repo ─────────────────────────────────────────────────────────────────
# The tarball, and only `labs/` out of it — NOT a clone.
#
# The rest of that repo is the portal: src/course/grading.ts holds every
# checkpoint's pass condition, src/course/sessions/*.ts holds the answers Session
# 2 deliberately withholds from the snippet, and INSTRUCTOR.md is the run-book,
# including where the workshop's soft spots are. None of that belongs in the
# working directory of thirty people holding Global Admin on the training account.
#
# The repo is public, so this is friction rather than a control — but a folder
# people are already sitting in gets grepped, and a repo they would have to go
# find does not. A tarball also removes it outright, where `git sparse-checkout`
# only hides it behind one command.
mkdir -p "$WORKSHOP_DIR"

# github.com/<owner>/<repo>[.git] -> <owner>/<repo>. The API tarball endpoint is
# used for both public and private: it takes an Authorization header, where the
# /archive/ URL wants the credential in the URL itself.
REPO_PATH="${LAB_REPO_URL#https://github.com/}"
REPO_PATH="${REPO_PATH%.git}"
case "$REPO_PATH" in
    */*) ;;
    *) echo "ERROR: LAB_REPO_URL is not a github.com https URL: $LAB_REPO_URL"; exit 1 ;;
esac
# A branch name containing a slash — taonic/python, the default above — has to be
# FULLY QUALIFIED on this endpoint. `tarball/taonic/python` is ambiguous to GitHub
# and answers 504, which reads like an outage rather than like a malformed ref;
# `tarball/refs/heads/taonic/python` redirects to the archive as intended. So
# qualify it here rather than making every track config remember to.
#
# Only branches are assumed. A TAG whose name contains a slash must be given
# already-qualified, as refs/tags/<name>, and passes through untouched.
case "$LAB_REPO_REF" in
    refs/*)  TARBALL_REF="$LAB_REPO_REF" ;;
    */*)     TARBALL_REF="refs/heads/$LAB_REPO_REF" ;;
    *)       TARBALL_REF="$LAB_REPO_REF" ;;
esac
TARBALL_URL="https://api.github.com/repos/$REPO_PATH/tarball/$TARBALL_REF"

# xtrace off around every line that touches the token, same reasoning as the
# clone this replaced: the setup log is readable by anyone debugging the track.
set +x
FETCH_OK=0
if [ -n "$LAB_REPO_TOKEN" ]; then
    curl -fsSL -H "Authorization: Bearer $LAB_REPO_TOKEN" -o /tmp/labs.tar.gz "$TARBALL_URL" 2>/dev/null \
        && FETCH_OK=1
else
    curl -fsSL -o /tmp/labs.tar.gz "$TARBALL_URL" 2>/dev/null && FETCH_OK=1
fi
set -x

if [ "$FETCH_OK" -ne 1 ]; then
    echo "ERROR: could not fetch $LAB_REPO_URL (ref $LAB_REPO_REF)."
    echo "       Tried: $TARBALL_URL"
    if [ -z "$LAB_REPO_TOKEN" ]; then
        echo "       No LAB_REPO_TOKEN was set — a private repo needs one."
    else
        echo "       LAB_REPO_TOKEN was set — check the token's scope and expiry."
    fi
    echo "       Set LAB_REPO_URL / LAB_REPO_REF / LAB_REPO_TOKEN in the track config."
    exit 1
fi

# The archive's single top-level directory is stripped, and the member filter
# keeps only labs/ — so this lands at exactly $WORKSHOP_DIR/labs, the path every
# helper, alias and health check below already expects.
#
# One pattern, not two. GNU tar recurses into a matched directory, so '*/labs'
# already brings the whole subtree; adding '*/labs/*' makes tar report it as an
# unmatched pattern and exit 2, which under `set -e` kills the build.
tar -xz -f /tmp/labs.tar.gz -C "$WORKSHOP_DIR" --strip-components=1 --wildcards '*/labs'
rm -f /tmp/labs.tar.gz

[ -d "$WORKSHOP_DIR/labs" ] || { echo "ERROR: $WORKSHOP_DIR/labs missing — wrong LAB_REPO_URL?"; exit 1; }

# Nothing else from the repo should have survived the member filter. Checked
# rather than assumed, because the failure mode is silent: a tar that quietly
# extracted everything looks identical until a student opens grading.ts.
#
# `instruqt` is on the list because this preset now lives inside the lab repo, at
# instruqt/sandbox — so a filter that stopped holding would drop the setup script,
# its health checks and the /opt/solutions sentinels into the working directory of
# the people the snapshots exist to help.
for leaked in src INSTRUCTOR.md README.md package.json instruqt; do
    if [ -e "$WORKSHOP_DIR/$leaked" ]; then
        echo "ERROR: $leaked was extracted — the tar member filter did not hold"
        exit 1
    fi
done

# The worker reads .env from the working directory upward. Seeding it empty
# means `workshop-creds` has a file to fill and students never hunt for the
# example.
[ -f "$WORKSHOP_DIR/labs/worker/.env" ] \
    || cp "$WORKSHOP_DIR/labs/worker/.env.example" "$WORKSHOP_DIR/labs/worker/.env"

# ─── The worker the lab repo shipped ──────────────────────────────────────────
# One stack, so this is an assertion rather than a decision. A labs/worker with no
# pyproject.toml means the fetched ref predates the Python worker (LAB_REPO_REF
# pointing at an old branch is the likely cause), and failing here is far cheaper
# than a room discovering it at `uv run`.
WORKER_DIR="$WORKSHOP_DIR/labs/worker"
if [ ! -f "$WORKER_DIR/pyproject.toml" ]; then
    echo "ERROR: $WORKER_DIR has no pyproject.toml — the fetched lab repo does not"
    echo "       ship the Python worker. Check LAB_REPO_REF ($LAB_REPO_REF)."
    exit 1
fi

# ─── Pre-warm Terraform and the worker toolchain ──────────────────────────────
# `terraform init` is the only Terraform setup step in the lab, and it is a
# network download. Do it now so Session 1 starts at `terraform plan`.
(cd "$WORKSHOP_DIR/labs" && terraform init -input=false -upgrade)

# Create labs/worker/.venv from the committed uv.lock here, and the student's
# first `uv run lab1_hello.py worker` starts in about a second instead of resolving
# and downloading temporalio.
#
# --locked first: it asserts uv.lock is in sync with pyproject.toml, and the
# preset build is the cheap place to discover that it is not. Not fatal,
# deliberately — the lockfile may have been written by an older uv than the one
# pinned here, and a lockfile-revision nit is not a reason to fail a whole
# track. So fall back to --frozen (install exactly what the lock says, no
# re-resolution) and say so loudly enough to find in the build log.
if ! (cd "$WORKER_DIR" && uv sync --locked); then
    echo "WARN: uv.lock is not in sync with pyproject.toml (or was written by an"
    echo "      incompatible uv). Installing from the lock as-is with --frozen."
    (cd "$WORKER_DIR" && uv sync --frozen)
fi

# Prove the environment imports the SDK rather than merely existing. --offline
# also exercises the no-network path: the lock is satisfied by now, so a
# student's first run should not reach out for anything.
(cd "$WORKER_DIR" \
    && uv run --offline python -c 'import temporalio; print("temporalio", temporalio.__version__)')

# ─── code-server ──────────────────────────────────────────────────────────────
# The published .deb at a pinned version, not `install.sh | sh`. Installed with
# apt-get rather than dpkg so its dependencies resolve. The release publishes no
# checksum manifest, so the version pin is the whole guarantee here.
curl -fsSL -o /tmp/code-server.deb \
    "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_${DPKG_ARCH}.deb"
apt-get install -y --no-install-recommends /tmp/code-server.deb
rm -f /tmp/code-server.deb

code-server --version

mkdir -p /root/.local/share/code-server/User

# python.defaultInterpreterPath points at the venv `uv sync` creates, so the editor
# resolves `import temporalio` instead of underlining it in red against the system
# interpreter — cosmetic, but it reads to a student as "my worker is broken". The
# per-language tabSize entries matter for the same reason in reverse: 4 for Python,
# 2 for the .tf and .yaml files it sits next to.
cat > /root/.local/share/code-server/User/settings.json <<EOF
{
    "workbench.colorTheme": "Default Dark+",
    "workbench.startupEditor": "readme",
    "security.workspace.trust.enabled": false,
    "editor.fontSize": 14,
    "editor.tabSize": 4,
    "editor.renderWhitespace": "boundary",
    "files.exclude": {
        "**/__pycache__": true,
        "**/.venv": true,
        "**/.ruff_cache": true,
        "**/.terraform": true,
        "**/node_modules": true,
        "**/.next": true
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "terminal.integrated.scrollback": 20000,
    "python.defaultInterpreterPath": "$WORKSHOP_DIR/labs/worker/.venv/bin/python",
    "python.terminal.activateEnvironment": false,
    "[terraform]": { "editor.tabSize": 2 },
    "[yaml]": { "editor.tabSize": 2 },
    "workbench.activityBar.visible": true,
    "workbench.secondarySideBar.visible": false,
    "git.openRepositoryInParentFolders": "always"
}
EOF

# Open VSX rather than the Microsoft marketplace, which code-server cannot use.
# ms-python.python IS mirrored there, but its language server
# ms-python.vscode-pylance is not, and is licensed so that it cannot be —
# basedpyright is the drop-in that is.
#
# Non-fatal: a missing extension costs syntax highlighting, not a lab, and Open VSX
# availability is not something to fail a track on.
for ext in ms-python.python detachhead.basedpyright hashicorp.terraform redhat.vscode-yaml; do
    /usr/bin/code-server --install-extension "$ext" || echo "WARN: could not install $ext"
done

cat > /etc/systemd/system/code-server.service <<EOF
[Unit]
Description=Code Server
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=1
User=root
Environment=HOME=/root
# The same three uv paths the build used. Without them a terminal opened from the
# Editor tab resolves a different interpreter directory than the pre-warm did,
# and the first `uv run` re-downloads CPython.
Environment=UV_PYTHON_INSTALL_DIR=$UV_PYTHON_INSTALL_DIR
Environment=UV_CACHE_DIR=$UV_CACHE_DIR
Environment=UV_PYTHON_PREFERENCE=$UV_PYTHON_PREFERENCE
Environment=PATH=/root/.temporalio/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=/usr/bin/code-server --host 0.0.0.0 --port 8443 --cert --auth none $WORKSHOP_DIR

[Install]
WantedBy=multi-user.target
EOF

systemctl enable code-server
systemctl start code-server

echo "Waiting for code-server..."
for i in $(seq 1 30); do
    if curl -sfk https://localhost:8443 > /dev/null 2>&1; then
        echo "code-server healthy."
        break
    fi
    if [ "$i" -eq 30 ]; then echo "ERROR: code-server failed to start on port 8443"; exit 1; fi
    sleep 2
done

# ─── Local dev server — installed, DISABLED on purpose ────────────────────────
# Every lab in this course runs against Temporal Cloud, and Session 4's
# temporal-proxy binds 127.0.0.1:7233. A dev server on 7233 would take that
# port and the proxy would fail with "address already in use" mid-session.
#
# So the unit exists as a fallback for when Cloud egress is broken and the room
# still needs to see a worker run (`worker-run worker --local`), and it is enabled
# by hand:
#
#   dev-server-up      # then rw --local  (or worker-run worker --local)
#   dev-server-down    # BEFORE starting the Session 4 proxy
cat > /etc/systemd/system/temporal-dev.service <<'EOF'
[Unit]
Description=Temporal Dev Server (fallback — not started by default)
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/temporal server start-dev \
    --ui-port 8233 \
    --ip 0.0.0.0 \
    --db-filename /workspace/temporal.db
Restart=on-failure
RestartSec=5
StandardOutput=append:/workspace/temporal-dev.log
StandardError=append:/workspace/temporal-dev.log

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl disable temporal-dev || true

# ─── Credentials helper ───────────────────────────────────────────────────────
# Students get a namespace, an account and an API key from the training portal
# at the start of Session 1 — none of it can be baked into the image. This
# writes all four variables to the two places that read them: the shell (both
# CLIs and the Terraform provider) and labs/worker/.env (the Python worker).
cat > /usr/local/bin/workshop-creds <<'EOF'
#!/bin/bash
# Point this sandbox at your Temporal Cloud namespace.
#
#   workshop-creds                                  interactive
#   workshop-creds <address> <namespace> <api-key>   non-interactive
#
# Values come from the "Connection details" block at the top of any session
# page in the training portal. Run `source ~/.workshop-env` afterwards, or open
# a new terminal.
set -euo pipefail

WORKSHOP_DIR="${WORKSHOP_DIR:-/workspace/workshop}"
ENV_FILE=/root/.workshop-env
WORKER_ENV="$WORKSHOP_DIR/labs/worker/.env"

ADDRESS="${1:-}"
NAMESPACE="${2:-}"
API_KEY="${3:-}"

[ -n "$ADDRESS" ]   || read -r -p "TEMPORAL_ADDRESS   (e.g. training-you.bvmon.tmprl.cloud:7233): " ADDRESS
[ -n "$NAMESPACE" ] || read -r -p "TEMPORAL_NAMESPACE (e.g. training-you.bvmon):                 " NAMESPACE
if [ -z "$API_KEY" ]; then
    read -r -s -p "TEMPORAL_API_KEY   (not echoed):                                 " API_KEY
    echo
fi

for pair in "ADDRESS:$ADDRESS" "NAMESPACE:$NAMESPACE" "API_KEY:$API_KEY"; do
    if [ -z "${pair#*:}" ]; then
        echo "ERROR: ${pair%%:*} is empty — nothing written." >&2
        exit 1
    fi
done

umask 077
cat > "$ENV_FILE" <<INNER
# Written by workshop-creds. Sourced from ~/.bashrc.
export TEMPORAL_ADDRESS='$ADDRESS'
export TEMPORAL_NAMESPACE='$NAMESPACE'
# Read by: temporal, temporal cloud
export TEMPORAL_API_KEY='$API_KEY'
# Read by: the temporalcloud Terraform provider. Same key, different name —
# the provider does not look at TEMPORAL_API_KEY.
export TEMPORAL_CLOUD_API_KEY='$API_KEY'
INNER

if [ -f "$WORKER_ENV" ]; then
    umask 077
    cat > "$WORKER_ENV" <<INNER
# Written by workshop-creds. The Python worker reads this file (training/config.py),
# and it WINS over an exported variable of the same name — which is what makes
# Session 2's service-account key take effect without unsetting your admin key.
TEMPORAL_ADDRESS=$ADDRESS
TEMPORAL_NAMESPACE=$NAMESPACE
TEMPORAL_API_KEY=$API_KEY
INNER
    echo "Wrote $WORKER_ENV"
fi

echo "Wrote $ENV_FILE"
echo
echo "Then check it: source $ENV_FILE && workshop-check"
EOF
chmod +x /usr/local/bin/workshop-creds

# ─── Health-check helper ──────────────────────────────────────────────────────
# The same checks the setup runs, re-runnable by a student or by you when
# something stops working mid-session.
cat > /usr/local/bin/workshop-check <<'EOF'
#!/bin/bash
# Verify tools, egress and (if configured) the Cloud connection.
# No `set -e` and no `pipefail` on purpose: this is a diagnostic, and it has to
# run every probe rather than stopping at the first thing that is broken.
set -u

fail=0
ok()   { printf '  \033[32mok\033[0m    %s\n' "$1"; }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; fail=1; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$1"; }

echo "Tools"
for probe in \
    "temporal:temporal --version" \
    "temporal cloud:temporal cloud --help" \
    "terraform:terraform version" \
    "uv:uv --version" \
    "docker:docker info" \
    "docker compose:docker compose version" \
    "git:git --version"
do
    name="${probe%%:*}"; cmd="${probe#*:}"
    if $cmd > /dev/null 2>&1; then ok "$name"; else bad "$name"; fi
done

echo
echo "Worker (labs/worker)"
WORKER_DIR="${WORKSHOP_DIR:-/workspace/workshop}/labs/worker"
# `uv run` is what every lab command actually starts with, so probe that rather
# than `python --version` — and --offline, so a green tick means the venv and the
# cache are both already warm and the student's first run does not go to the
# network.
if v="$(cd "$WORKER_DIR" 2>/dev/null && uv run --offline python -c \
    'import platform, temporalio; print(platform.python_version(), temporalio.__version__)' 2>/dev/null)"; then
    ok "python ${v% *} + temporalio ${v#* } (uv)"
else
    bad "python env not usable — rebuild: cd $WORKER_DIR && uv sync"
fi

echo
echo "Outbound network (PREREQUISITES.md 'most likely to be blocked')"
# The address every lab actually dials is <namespace>.<account>.tmprl.cloud:7233,
# which does not exist until Session 1 creates it. So probe the regional endpoint
# for the region the labs pin (aws-ap-southeast-2): same port, same cloud, and it
# resolves before anyone has provisioned anything.
if nc -z -w 5 ap-southeast-2.aws.api.temporal.io 7233 2>/dev/null; then
    ok "gRPC to Temporal Cloud on 7233 (aws ap-southeast-2)"
else
    bad "gRPC to Temporal Cloud on 7233 — nothing in this workshop connects"
fi
# pypi.org and files.pythonhosted.org are a pair: the first serves the index, the
# second serves the wheels, and only one of them being open is a `uv sync` that
# resolves and then fails to download — which reads like a broken package rather
# than like a firewall.
for hostport in saas-api.tmprl.cloud:443 registry.terraform.io:443 pypi.org:443 files.pythonhosted.org:443 registry-1.docker.io:443 github.com:443; do
    if nc -z -w 5 "${hostport%%:*}" "${hostport##*:}" 2>/dev/null; then ok "$hostport"; else bad "$hostport"; fi
done

echo
echo "Your namespace"
if [ -z "${TEMPORAL_ADDRESS:-}" ] || [ -z "${TEMPORAL_API_KEY:-}" ]; then
    warn "not configured yet — run: workshop-creds"
else
    # Account level first. It answers before Session 1 has provisioned anything,
    # and its answer is what tells the namespace probe below how to read a
    # failure: a namespace that does not exist YET is the expected state when a
    # student runs this before `terraform apply`, and calling that FAIL sends
    # them hunting for a broken key that is working perfectly.
    #
    # --api-key explicitly: the CLI reads TEMPORAL_API_KEY, but the Cloud
    # extension is a separate pre-release binary and this removes the question.
    ns_list="$(mktemp)"
    if temporal cloud namespace list --api-key "$TEMPORAL_API_KEY" > "$ns_list" 2>/dev/null; then
        ok "Cloud Ops API (temporal cloud)"
        # Short name, so this matches whether the listing prints `foo` or
        # `foo.account`. A substring hit is good enough for a diagnostic.
        if grep -q -- "${TEMPORAL_NAMESPACE%%.*}" "$ns_list"; then
            ns_state=exists
        else
            ns_state=absent
        fi
    else
        bad "temporal cloud namespace list failed — key may lack account access"
        ns_state=unknown
    fi
    rm -f "$ns_list"

    if temporal workflow list --limit 1 > /dev/null 2>&1; then
        ok "$TEMPORAL_NAMESPACE reachable at $TEMPORAL_ADDRESS"
    elif [ "$ns_state" = absent ]; then
        warn "$TEMPORAL_NAMESPACE does not exist yet — Session 1's terraform apply creates it. Expected before then; re-run this after."
    else
        bad "cannot reach $TEMPORAL_NAMESPACE at $TEMPORAL_ADDRESS — wrong address, wrong namespace, or API key auth not enabled on it"
    fi
fi

echo
echo "Local services"
curl -sfk https://localhost:8443 > /dev/null 2>&1 && ok "code-server :8443" || bad "code-server :8443"
systemctl is-active --quiet temporal-dev \
    && warn "local dev server is running on 7233 — run dev-server-down before Session 4's proxy" \
    || ok "port 7233 free for Session 4's proxy"

echo
[ "$fail" -eq 0 ] && echo "All good." || { echo "Something above needs fixing."; exit 1; }
EOF
chmod +x /usr/local/bin/workshop-check

# ─── Worker runner ────────────────────────────────────────────────────────────
# One command that runs a labs/worker entrypoint from anywhere:
#
#   worker-run lab1_hello.py worker   ->  uv run lab1_hello.py worker
#
# It survives the .NET removal as a `cd` plus an echo rather than a dispatcher —
# the cd is what lets rw / rs / rm5 work from any directory, and the echo is what
# stops it being a black box: it prints the real command first, because a student
# comparing the sandbox against the session page needs to see the same words.
#
# The Python starter has one entrypoint per lab (lab1_hello.py, lab3_metrics.py,
# lab4_review.py, lab5_chaos.py), so the script name is the FIRST argument.
cat > /usr/local/bin/worker-run <<'EOF'
#!/bin/bash
# Run a labs/worker command.
#
#   worker-run <script> <command> [flags...]
set -euo pipefail

WORKSHOP_DIR="${WORKSHOP_DIR:-/workspace/workshop}"
WORKER_DIR="$WORKSHOP_DIR/labs/worker"

[ -d "$WORKER_DIR" ] || { echo "ERROR: $WORKER_DIR does not exist." >&2; exit 1; }
cd "$WORKER_DIR"
[ -f pyproject.toml ] || { echo "ERROR: no pyproject.toml in $WORKER_DIR." >&2; exit 1; }

echo "+ uv run $*"
exec uv run "$@"
EOF
chmod +x /usr/local/bin/worker-run

# ─── Convenience wrappers ─────────────────────────────────────────────────────
cat > /usr/local/bin/dev-server-up <<'EOF'
#!/bin/bash
set -euo pipefail
systemctl start temporal-dev
echo "Dev server starting on 127.0.0.1:7233, UI on :8233."
echo "This takes port 7233 — run dev-server-down before Session 4's proxy."
EOF

cat > /usr/local/bin/dev-server-down <<'EOF'
#!/bin/bash
set -euo pipefail
systemctl stop temporal-dev || true
echo "Dev server stopped. Port 7233 is free."
EOF

chmod +x /usr/local/bin/dev-server-up /usr/local/bin/dev-server-down

# Session 4: the proxy wants the SHORT namespace name and the account id, which
# is exactly what labs/worker/.env does NOT hold. Deriving both here removes the
# most common Session 4 mistake without hiding the mechanism — the command it
# runs is the one in labs/proxy/README.md.
cat > /usr/local/bin/proxy-up <<EOF
#!/bin/bash
# Session 4 — run temporal-proxy in the foreground on 127.0.0.1:7233.
set -euo pipefail
: "\${TEMPORAL_NAMESPACE:?run workshop-creds first}"
: "\${TEMPORAL_API_KEY:?run workshop-creds first}"

# The proxy appends the account itself, so strip it off the fully-qualified name.
export TEMPORAL_NAMESPACE="\${TEMPORAL_NAMESPACE%%.*}"
export TEMPORAL_ACCOUNT="\${TEMPORAL_ACCOUNT:-$TEMPORAL_ACCOUNT}"
export TEMPORAL_API_KEY

echo "Proxy: \$TEMPORAL_NAMESPACE.\$TEMPORAL_ACCOUNT.tmprl.cloud:7233 -> 127.0.0.1:7233"
exec docker run --rm -p 7233:7233 \\
    -v "$WORKSHOP_DIR/labs/proxy/config.yaml:/config.yaml:ro" \\
    -e TEMPORAL_NAMESPACE -e TEMPORAL_ACCOUNT -e TEMPORAL_API_KEY \\
    $PROXY_IMAGE serve --config /config.yaml
EOF
chmod +x /usr/local/bin/proxy-up

# ─── Recovery snapshots ───────────────────────────────────────────────────────
# The whole workshop is one day in one sandbox with nothing persisted outside it.
# If a sandbox dies at Session 4, the student's Cloud resources still exist but
# every line of Terraform they wrote is gone, and re-pasting it from four session
# pages while the room waits is not a recovery.
#
# So: the state labs/ should be in after each session, baked in. Only lab1.tf and
# lab2.tf are ever student-authored — Sessions 3 and 4 add no Cloud resources, and
# Sessions 5 and 6 only add a key to lab1.tf's tag block.
#
# 0700 and /opt, deliberately. This is an instructor tool, not a hint sheet: it
# lives outside $WORKSHOP_DIR so `ls` in the lab directory never reveals it, and
# it is not mentioned in workshop-help. See the preset README.
mkdir -p /opt/solutions
chmod 700 /opt/solutions

# Sentinels rather than real names: the per-student values are derived from the
# student's email by the portal and are not knowable at build time. restore-labs
# substitutes them. The three non-namespace names all derive from the namespace
# short name, so restoring only ever needs that one value.
emit_lab1() {
    local dir="$1"; shift
    mkdir -p "$dir"
    {
        cat <<'HCL'
# Restored from the session snapshot. See restore-labs.
#
# The terraform block and provider live in versions.tf / providers.tf — this
# file holds resources only.

resource "temporalcloud_namespace" "lab" {
  name           = "__NAMESPACE_NAME__"
  regions        = ["__REGION__"]
  retention_days = 7
  api_key_auth   = true
}

# ONE tags resource for the whole workshop. It manages the COMPLETE tag set, so a
# second one would wipe every key the earlier sessions wrote.
resource "temporalcloud_namespace_tags" "lab" {
  namespace_id = temporalcloud_namespace.lab.id

  tags = {
    "provisioner" = "terraform"
HCL
        for line in "$@"; do printf '    %s\n' "$line"; done
        cat <<'HCL'
  }
}

output "namespace_endpoint" {
  value = temporalcloud_namespace.lab.endpoints
}
HCL
    } > "$dir/lab1.tf"
}

cat > /opt/solutions/lab2.tf <<'HCL'
# Restored from the session snapshot. See restore-labs.
#
# The control-plane access a Worker needs, which is very nearly none. A Worker
# polls a task queue and completes tasks; it never calls the Cloud Ops API to do
# its job. So this grants ONE action, on ONE namespace, by id.
resource "temporalcloud_custom_role" "worker" {
  name        = "__CUSTOM_ROLE__"
  description = "Read one namespace. Nothing else."

  permissions = [
    {
      actions = ["cloud.namespace.get"]
      resources = {
        resource_type = "namespaces"
        resource_ids  = ["__NAMESPACE_ID__"]
        allow_all     = false
      }
    },
  ]
}

resource "temporalcloud_service_account" "worker" {
  name = "__SERVICE_ACCOUNT__"

  # The FLOOR, not "developer". Custom roles are additive and cannot take
  # permissions away, so whatever is set here is the minimum this identity will
  # ever have.
  account_access              = "read"
  account_access_custom_roles = [temporalcloud_custom_role.worker.id]

  # The grant that actually matters. "write" is what lets a Worker poll task
  # queues and complete Workflow and Activity Tasks.
  namespace_accesses = [
    {
      namespace_id = temporalcloud_namespace.lab.id
      permission   = "write"
    }
  ]
}

# Owned by the service account, so it outlives any individual.
resource "temporalcloud_apikey" "worker" {
  display_name = "__SERVICE_ACCOUNT__"
  owner_type   = "service-account"
  owner_id     = temporalcloud_service_account.worker.id
  expiry_time  = "2026-12-31T00:00:00Z"
  disabled     = false
}

# The operators group — the half of Session 2 the portal deliberately does not
# hand you. temporalcloud_group only creates the identity; without an access
# block it grants nothing, which is the point of the exercise.
resource "temporalcloud_group" "operators" {
  name = "__GROUP__"
}

resource "temporalcloud_group_access" "operators" {
  id             = temporalcloud_group.operators.id
  account_access = "read"

  namespace_accesses = [
    {
      namespace_id = temporalcloud_namespace.lab.id
      permission   = "write"
    }
  ]
}

# Terraform will not print a sensitive value unless you ask for it by name:
#   terraform output -raw worker_api_key
output "worker_api_key" {
  value     = temporalcloud_apikey.worker.token
  sensitive = true
}
HCL

# Sessions 5 and 6 are graded on a non-empty tag, so these placeholders pass the
# checkpoint while being obviously not the student's own link. Said in as many
# words in the file, because a grader that goes green on a value nobody wrote is
# exactly the kind of false pass the portal's checkpoint design avoids elsewhere.
# Padded to line up with "provisioner", which is the longest key — `terraform fmt`
# would do this anyway, and a restored file that fails `fmt -check` is a diff the
# student has to think about on the worst morning of their workshop.
S5_TAG='"session-5"   = "RESTORED — replace with your dashboard link"'
S6_TAG='"session-6"   = "RESTORED — replace with your runbook link"'

emit_lab1 /opt/solutions/after-1
emit_lab1 /opt/solutions/after-2
emit_lab1 /opt/solutions/after-3
emit_lab1 /opt/solutions/after-4
emit_lab1 /opt/solutions/after-5 "$S5_TAG"
emit_lab1 /opt/solutions/after-6 "$S5_TAG" "$S6_TAG"

# Sessions 2 onward all carry lab2.tf unchanged — nothing after Session 2 adds a
# control-plane resource.
for n in 2 3 4 5 6; do
    cp /opt/solutions/lab2.tf "/opt/solutions/after-$n/lab2.tf"
done
rm -f /opt/solutions/lab2.tf
chmod -R go-rwx /opt/solutions

cat > /usr/local/bin/restore-labs <<'EOF'
#!/bin/bash
# Rebuild labs/*.tf as they should look after a given session.
#
#   restore-labs <session 1-6> [namespace-short-name]
#
# For the sandbox that died mid-workshop. It restores the Terraform SOURCE only —
# there is no state file to restore, so the resources that already exist in Cloud
# have to be imported before the next apply. The closing notes say how.
set -euo pipefail

WORKSHOP_DIR="${WORKSHOP_DIR:-/workspace/workshop}"
LABS="$WORKSHOP_DIR/labs"
REGION="${LAB_REQUIRED_REGION:-aws-ap-southeast-2}"

N="${1:-}"
case "$N" in
    1|2|3|4|5|6) ;;
    *) echo "usage: restore-labs <session 1-6> [namespace-short-name]" >&2; exit 1 ;;
esac

SRC="/opt/solutions/after-$N"
[ -d "$SRC" ] || { echo "ERROR: no snapshot at $SRC" >&2; exit 1; }
[ -d "$LABS" ] || { echo "ERROR: $LABS does not exist — is the lab repo cloned?" >&2; exit 1; }

# Default to the namespace workshop-creds already configured. TEMPORAL_NAMESPACE
# holds the fully-qualified <namespace>.<account>; the short name is the part the
# resource names are built from.
NS_SHORT="${2:-${TEMPORAL_NAMESPACE%%.*}}"
if [ -z "$NS_SHORT" ]; then
    read -r -p "Your namespace short name (e.g. training-you, from your session page): " NS_SHORT
fi
[ -n "$NS_SHORT" ] || { echo "ERROR: no namespace name given." >&2; exit 1; }

ACCOUNT="${TEMPORAL_ACCOUNT:-bvmon}"
NS_ID="$NS_SHORT.$ACCOUNT"

# Every other per-student name derives from the namespace short name — the portal
# builds them the same way (naming.ts), so nothing here has to be typed twice.
SA="$NS_SHORT-worker"
GROUP="$NS_SHORT-operators"
ROLE="$NS_SHORT-worker-role"

STAMP="$(date +%Y%m%d-%H%M%S)"
BACKUP="$LABS/.restored-$STAMP"
mkdir -p "$BACKUP"
for f in lab1.tf lab2.tf; do
    [ -f "$LABS/$f" ] && cp "$LABS/$f" "$BACKUP/$f"
done
echo "Existing lab1.tf / lab2.tf backed up to $BACKUP"

for f in "$SRC"/*.tf; do
    base="$(basename "$f")"
    sed -e "s|__NAMESPACE_NAME__|$NS_SHORT|g" \
        -e "s|__NAMESPACE_ID__|$NS_ID|g" \
        -e "s|__REGION__|$REGION|g" \
        -e "s|__SERVICE_ACCOUNT__|$SA|g" \
        -e "s|__GROUP__|$GROUP|g" \
        -e "s|__CUSTOM_ROLE__|$ROLE|g" \
        "$f" > "$LABS/$base"
    echo "Wrote labs/$base"
done

echo
echo "Restored to end of Session $N for namespace $NS_ID."
echo
echo "The Terraform is back. The STATE is not — these resources exist in Cloud and"
echo "Terraform does not know it yet, so import before you apply:"
echo
echo "  cd $LABS"
echo "  terraform init"
echo "  terraform import temporalcloud_namespace.lab $NS_ID"
echo "  terraform plan          # then import whatever it proposes to CREATE"
echo
echo "Ids for the rest come from the CLI:"
echo "  temporal cloud service-account list"
echo "  temporal cloud user-group list"
echo
echo "One exception: the API key. Its secret cannot be imported, so let Terraform"
echo "create a new one and delete the old key in the Cloud UI."
if [ "$N" -ge 4 ]; then
    echo
    echo "Session 4+: also uncomment the 'encryption:' block at the foot of"
    echo "  labs/proxy/config.yaml — that edit is not Terraform and is not restored here."
fi
if [ "$N" -ge 5 ]; then
    echo
    echo "Sessions 5/6 tags are placeholders. Put your real dashboard and runbook"
    echo "links into lab1.tf's tag block before the final re-check."
fi
EOF
chmod +x /usr/local/bin/restore-labs

# ─── Shell environment ────────────────────────────────────────────────────────
cat >> /etc/environment <<EOF
UV_PYTHON_INSTALL_DIR=$UV_PYTHON_INSTALL_DIR
UV_CACHE_DIR=$UV_CACHE_DIR
UV_PYTHON_PREFERENCE=$UV_PYTHON_PREFERENCE
TEMPORAL_ACCOUNT=$TEMPORAL_ACCOUNT
EOF

# Empty but present, so ~/.bashrc can source it unconditionally before the
# student has run workshop-creds.
touch /root/.workshop-env
chmod 600 /root/.workshop-env

cat >> /root/.bashrc <<EOF
export PATH="\$PATH:/root/.temporalio/bin:/usr/local/bin"

# uv reads these three. They have to match what the preset build used, or the
# first \`uv run\` in a student's terminal looks in an empty interpreter directory
# and downloads CPython again. only-managed keeps it off the image's own python3.
export UV_PYTHON_INSTALL_DIR=$UV_PYTHON_INSTALL_DIR
export UV_CACHE_DIR=$UV_CACHE_DIR
export UV_PYTHON_PREFERENCE=$UV_PYTHON_PREFERENCE

export TEMPORAL_ACCOUNT=$TEMPORAL_ACCOUNT
export WORKSHOP_DIR=$WORKSHOP_DIR

# Session 2 only. A shared service account holds the delegation that lets a
# custom role be created at all — Global Admin cannot, and granting a student
# that permission would strip their DATA-PLANE access for the rest of the day.
# Two resources in lab2.tf name the aliased provider that reads this; nothing
# else does, so every other lab still runs as the student.
#
# TF_VAR_ is how Terraform takes a variable from the environment. It is
# deliberately NOT TEMPORAL_CLOUD_API_KEY: that stays the student's own key.
export TF_VAR_elevated_api_key=${WORKSHOP_ELEVATED_API_KEY:-}

# Written by workshop-creds — namespace, address and API key.
[ -f /root/.workshop-env ] && . /root/.workshop-env
EOF

cat >> /root/.bashrc <<'EOF'

# Labs
alias labs='cd $WORKSHOP_DIR/labs'
alias worker='cd $WORKSHOP_DIR/labs/worker'

# Functions, not aliases, and that is the whole point: an alias appends the words
# you typed AFTER the closing paren, so `rw --version 2.0` used to expand to
# `(cd … && uv run worker) --version 2.0` and silently drop the flag on the
# floor. From Lab 3 on, dropping --version means a worker that polls forever and
# is handed nothing — the single most expensive way to lose twenty minutes in this
# workshop.
rw()  { worker-run worker "$@"; }
rs()  { worker-run start "$@"; }
rl()  { worker-run load "$@"; }
rm5() { worker-run worker --metrics-port 9464 "$@"; }
alias tl='temporal workflow list'
alias tcn='temporal cloud namespace list'
alias obs-up='(cd $WORKSHOP_DIR/labs/observability && docker compose up -d)'
alias obs-down='(cd $WORKSHOP_DIR/labs/observability && docker compose down)'

cd $WORKSHOP_DIR 2>/dev/null || true
EOF

# ─── Welcome banner ───────────────────────────────────────────────────────────
# A real command rather than only an MOTD file, because students live in
# code-server's terminal, which is not an SSH login shell and never renders
# /etc/update-motd.d. The MOTD hook just calls this.
cat > /usr/local/bin/workshop-help <<EOF
#!/bin/sh
cat <<'BANNER'

  Temporal Cloud Platform Workshop
  ─────────────────────────────────────────────────────────────────
  Everything PREREQUISITES.md asks for is already installed. Labs are in
  $WORKSHOP_DIR/labs — terraform init and the worker build are already done.

  labs/worker is Python, run through uv — the session pages' worker commands read
  \`uv run lab1_hello.py worker\`, and \`worker-run\` runs the same thing from
  any directory.

  First thing, once Session 1 gives you a namespace and an API key:

    workshop-creds        paste address / namespace / key
    workshop-check        confirm tools, egress and the connection

  Handy:
    labs / worker         cd into the lab directories
    rw / rs / rl          run the worker / start one workflow / start many
    rw --version 2.0      flags pass through — needed from Lab 3 on
    rm5                   worker with SDK metrics on :9464 (Lab 5)
    tl / tcn              temporal workflow list / cloud namespace list
    obs-up / obs-down     Session 5 Prometheus + Grafana  (:9090 / :3030)
    proxy-up              Session 4 temporal-proxy on 127.0.0.1:7233
    dev-server-up/-down   local dev server fallback (takes port 7233)
    workshop-help         this again

BANNER
EOF
chmod +x /usr/local/bin/workshop-help

mkdir -p /etc/update-motd.d
printf '#!/bin/sh\nexec /usr/local/bin/workshop-help\n' > /etc/update-motd.d/99-workshop
chmod +x /etc/update-motd.d/99-workshop

# Once per sandbox rather than once per terminal — this lab wants three of them
# open at a time and a banner in each is noise.
cat >> /root/.bashrc <<'EOF'

if [ -n "${PS1:-}" ] && [ ! -f /tmp/.workshop-greeted ]; then
    touch /tmp/.workshop-greeted
    workshop-help
fi
EOF

# ─── Health checks ────────────────────────────────────────────────────────────
echo "Running health checks..."

temporal --version                    || { echo "ERROR: temporal CLI"; exit 1; }
temporal cloud --help > /dev/null     || { echo "ERROR: temporal cloud extension not wired up"; exit 1; }
terraform version > /dev/null         || { echo "ERROR: terraform"; exit 1; }
docker info > /dev/null               || { echo "ERROR: docker daemon"; exit 1; }
docker compose version > /dev/null    || { echo "ERROR: docker compose plugin"; exit 1; }

uv --version > /dev/null              || { echo "ERROR: uv not installed"; exit 1; }
uv python list --only-installed | grep -q "cpython-${PYTHON_VERSION}\." \
    || { echo "ERROR: uv has no managed CPython $PYTHON_VERSION"; exit 1; }
[ -x /usr/local/bin/worker-run ] || { echo "ERROR: worker-run not installed"; exit 1; }

for image in "$PROXY_IMAGE" "$PROMETHEUS_IMAGE" "$GRAFANA_IMAGE"; do
    docker image inspect "$image" > /dev/null \
        || { echo "ERROR: image not pre-pulled: $image"; exit 1; }
done

curl -sfk https://localhost:8443 > /dev/null \
    || { echo "ERROR: code-server not responding on port 8443"; exit 1; }

[ -d "$WORKSHOP_DIR/labs/.terraform" ] \
    || { echo "ERROR: terraform init did not cache the provider"; exit 1; }

# The worker has to be RUNNABLE, not merely present — a .venv that exists and
# cannot import the SDK is the failure a student would otherwise find first.
[ -x "$WORKSHOP_DIR/labs/worker/.venv/bin/python" ] \
    || { echo "ERROR: uv sync did not create labs/worker/.venv"; exit 1; }
(cd "$WORKSHOP_DIR/labs/worker" && uv run --offline python -c 'import temporalio' > /dev/null) \
    || { echo "ERROR: labs/worker/.venv cannot import temporalio offline"; exit 1; }

for f in lab1.tf lab2.tf lab5.tf proxy/config.yaml observability/docker-compose.yml; do
    [ -f "$WORKSHOP_DIR/labs/$f" ] || { echo "ERROR: missing lab file: labs/$f"; exit 1; }
done

# Recovery snapshots. A missing one is only discovered on the day it is needed,
# which is the worst possible moment, so check them at build time instead.
[ -x /usr/local/bin/restore-labs ] || { echo "ERROR: restore-labs not installed"; exit 1; }
for n in 1 2 3 4 5 6; do
    [ -f "/opt/solutions/after-$n/lab1.tf" ] \
        || { echo "ERROR: missing recovery snapshot: after-$n/lab1.tf"; exit 1; }
    grep -q '__NAMESPACE_NAME__' "/opt/solutions/after-$n/lab1.tf" \
        || { echo "ERROR: after-$n/lab1.tf lost its substitution sentinel"; exit 1; }
done
for n in 2 3 4 5 6; do
    [ -f "/opt/solutions/after-$n/lab2.tf" ] \
        || { echo "ERROR: missing recovery snapshot: after-$n/lab2.tf"; exit 1; }
done
grep -q 'session-5' /opt/solutions/after-5/lab1.tf \
    || { echo "ERROR: after-5 snapshot is missing the session-5 tag"; exit 1; }
grep -q 'session-6' /opt/solutions/after-6/lab1.tf \
    || { echo "ERROR: after-6 snapshot is missing the session-6 tag"; exit 1; }

# Egress. This is the check that matters — a sandbox with every tool installed
# and port 7233 closed is a sandbox in which no lab works. WORKSHOP_STRICT_EGRESS=0
# turns it into a warning for the case where the preset build network is not the
# network the sandbox will run on.
egress() {
    local host="${1%%:*}" port="${1##*:}" why="$2"
    if nc -z -w 5 "$host" "$port"; then
        return 0
    fi
    if [ "$WORKSHOP_STRICT_EGRESS" = "1" ]; then
        echo "ERROR: $why"
        exit 1
    fi
    echo "WARN: $why (WORKSHOP_STRICT_EGRESS=0, continuing)"
}

# The endpoint the labs actually dial is <namespace>.<account>.tmprl.cloud:7233 and
# no namespace exists at build time, so this probes the regional endpoint for the
# region lab1.tf pins. It proves port 7233 is open outbound, in the right cloud.
egress ap-southeast-2.aws.api.temporal.io:7233 "outbound gRPC on 7233 is blocked from this sandbox"
egress saas-api.tmprl.cloud:443                 "cannot reach the Cloud Ops API on 443"

echo "All health checks passed. Preset setup complete."
