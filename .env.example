####################################################################
# Portal
####################################################################
# Fallback only. /instructor builds the invite link from the incoming request,
# so it is right even when Next picks a different port or you deploy behind a
# proxy. This value is used where there is no request, e.g. pnpm ops:preflight.
PORTAL_BASE_URL=http://localhost:3000

# HMAC key for the daily rotating invite link. Rotating this invalidates
# every outstanding link immediately.  openssl rand -base64 32
PORTAL_LINK_SECRET=

# Midnight in this zone is the rotation boundary. Keep it OUT of workshop
# hours: anchored to UTC it lands around midday in Australia/NZ.
PORTAL_LINK_TIMEZONE=Australia/Sydney

# The actual access control. The rotating link gates who can *request*; this
# gates who can *receive*. Comma-separated patterns:
#
#   example.com      that domain exactly
#   *.example.com    any subdomain of it, but not the bare domain
#   *              any domain — no restriction at all
#
# Empty denies everything, so a blank value fails closed rather than open.
# Setting `*` means the rotating link and the seat cap are the ONLY things
# between the internet and Global Admin on your training account.
PORTAL_ALLOWED_EMAIL_DOMAINS=*

# Invitations per rotation day.
PORTAL_DAILY_SEAT_CAP=25

# Guards /instructor and the control-plane mirror, which exposes every user's
# email address. Deliberately separate from the student link. openssl rand -hex 24
PORTAL_INSTRUCTOR_TOKEN=

# How long a student holds Global Admin.
ACCESS_TTL_HOURS=48

####################################################################
# Temporal Cloud Ops API — the account students are invited INTO
####################################################################
TRAINING_ACCOUNT_ID=bvmon
CLOUD_OPS_ADDRESS=saas-api.tmprl.cloud:443

# Must match the VERSION of the api-cloud revision proto/cloudservice.binpb
# was built from. See scripts/vendor-protos.mjs.
CLOUD_OPS_API_VERSION=v0.19.1

# API key with ROLE_ADMIN or ROLE_OWNER on the training account.
# NOTE: a student holding Global Admin can delete whatever identity owns this
# key. The opsCanary workflow exists to tell you when that has happened.
CLOUD_OPS_API_KEY=

# Custom role ids granted to every invited student, comma-separated, on top of
# their ROLE_ADMIN. Session 2's lab creates a custom role, and custom role
# administration defaults to the Account Owner — without a delegated role a
# student gets `PermissionDenied` from terraform. Create the role once from
# scripts/custom-role-delegation.json and put its id here. Empty is valid.
STUDENT_CUSTOM_ROLE_IDS=

####################################################################
# Temporal — where the portal's OWN workflows run
#
# Deliberately a different account from TRAINING_ACCOUNT_ID, so a student
# cannot delete the workflows that will later delete them.
####################################################################
TEMPORAL_NAMESPACE=tao.a2dd6
TEMPORAL_TASK_QUEUE=training-portal

# Pick ONE auth method — the addresses are NOT interchangeable.
#
# API key   -> REGIONAL address, and the namespace must have API key auth enabled:
#   TEMPORAL_ADDRESS=ap-southeast-2.aws.api.temporal.io:7233
#   TEMPORAL_API_KEY=...
#
# mTLS      -> NAMESPACE address:
#   TEMPORAL_ADDRESS=tao.a2dd6.tmprl.cloud:7233
#   TEMPORAL_TLS_CLIENT_CERT_PATH=./client.pem
#   TEMPORAL_TLS_CLIENT_KEY_PATH=./client.key
#
# On Fly.io and similar, secrets arrive as env vars and there is no file to
# point at — use base64 PEM instead of the *_PATH variants:
#   TEMPORAL_TLS_CLIENT_CERT_DATA=$(base64 -i client.pem)
#   TEMPORAL_TLS_CLIENT_KEY_DATA=$(base64 -i client.key)
TEMPORAL_ADDRESS=ap-southeast-2.aws.api.temporal.io:7233
TEMPORAL_API_KEY=

####################################################################
# Sweeper
####################################################################
# 'dry-run' reports what it would delete and deletes nothing. Run one pass in
# dry-run against the real account before switching to 'live'.
SWEEPER_MODE=live
SWEEPER_INTERVAL_MINUTES=15

####################################################################
# Session 1 lab
####################################################################
LAB_NAMESPACE_PREFIX=training-
# Verify with `pnpm ops:preflight` — it lists the ids this account can use.
LAB_REQUIRED_REGION=azure-australiaeast

####################################################################
# Name guard (pnpm check:names)
####################################################################
# Comma-separated customer names this repo must never ship. The guard fails the
# build if one appears outside course.md, .env.local and labs/lab*.tf. Set it
# before you start work for a new customer; leave it empty to disable the guard
# deliberately. Unset is an error, not a pass.
CUSTOMER_NAMES=
