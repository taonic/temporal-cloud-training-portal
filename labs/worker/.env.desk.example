# INSTRUCTOR ONLY. The Risk Desk handler connects here — a namespace the students
# have no access to, which is what makes the Nexus demo honest.
#
# Copy to .env.desk. It is gitignored, and it is loaded ON TOP of .env, so you
# only need the keys that differ.
#
#   cp .env.desk.example .env.desk && $EDITOR .env.desk
#   uv run --group desk lab4_review.py desk
#
# Rehearsing on a dev server instead? You need no file at all — two namespaces on
# one machine, with --namespace picking between them:
#
#   temporal server start-dev --namespace caller-ns --namespace desk-ns
#   temporal operator nexus endpoint create --name risk-desk \
#     --target-namespace desk-ns --target-task-queue risk-desk
#
#   uv run --group desk lab4_review.py desk   --local --namespace desk-ns
#   uv run lab4_review.py worker              --local --namespace caller-ns
#   uv run lab4_review.py review              --local --namespace caller-ns

# The NAMESPACE endpoint for your desk namespace.
TEMPORAL_ADDRESS=

# <desk-namespace>.<account>
TEMPORAL_NAMESPACE=

# A key that can write to the desk namespace. Not a student's.
TEMPORAL_API_KEY=

# Account-global endpoint name. Only set this if you named it something other
# than `risk-desk` — and note that it is read by the STARTER, not the workflow,
# so changing it only affects calls made after the change. Executions already in
# flight carry the old name in their history for ever.
# NEXUS_ENDPOINT=risk-desk

# The desk's model. `simulated` (the default) needs no provider, no API key and
# no network, and produces a workflow history identical to the real thing.
# DESK_MODEL=anthropic:claude-opus-5

# Seconds per simulated model request. ~2.0 makes a review take about ten
# seconds: slow enough to watch, fast enough for a room of twelve.
# DESK_THINK_SECONDS=2.0
