# INSTRUCTOR ONLY. The Rate Desk handler connects here — a namespace the students
# have no access to, which is what makes the Nexus demo honest.
#
# Copy to .env.desk. It is gitignored, and it is loaded ON TOP of .env, so you
# only need the keys that differ.
#
#   cp .env.desk.example .env.desk && $EDITOR .env.desk
#   uv run main.py desk
#
# Rehearsing on a dev server instead? You need no file at all — three namespaces
# on one machine, with --namespace picking between them:
#
#   temporal server start-dev
#   temporal operator namespace create --namespace rate-desk-ns
#   temporal operator nexus endpoint create --name rate-desk \
#     --target-namespace rate-desk-ns --target-task-queue rate-desk
#   uv run main.py desk  --local --namespace rate-desk-ns
#   uv run main.py worker --local --namespace default
#   uv run main.py quote  --local --namespace default --as default

# The NAMESPACE endpoint for your desk namespace.
TEMPORAL_ADDRESS=

# <desk-namespace>.<account>
TEMPORAL_NAMESPACE=

# A key that can write to the desk namespace. Not a student's.
TEMPORAL_API_KEY=

# Account-global endpoint name. Only set this if you renamed it.
# NEXUS_ENDPOINT=rate-desk
