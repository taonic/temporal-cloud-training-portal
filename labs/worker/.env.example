# Written by `workshop-creds`, or copy this file to .env and fill it in from the
# "Connection details" block on any session page in the training portal.
#
# THIS FILE WINS over an exported variable of the same name. That matters from
# Session 2 on: your shell carries your personal admin key as TEMPORAL_API_KEY,
# and the key below is the Worker's own. The Worker must use this one, so it
# takes precedence rather than deferring to whatever the shell exported.
#
# Not needed at all if you run against a local dev server:
#   dev-server-up
#   uv run lab1_hello.py worker --local

# The NAMESPACE endpoint, e.g. training-tao.bvmon.tmprl.cloud:7233
TEMPORAL_ADDRESS=

# <namespace>.<account>, e.g. training-tao.bvmon
TEMPORAL_NAMESPACE=

# The Worker's own credential. From Lab 2 onward this should be the
# service-account key, which Lab 2 writes here for you:
#
#   cd labs && terraform output -raw worker_api_key
#
# Before you have built that, your personal key from Lab 1 works. Either
# way the namespace must have API key auth enabled, which the Lab 1
# Terraform sets with api_key_auth = true.
TEMPORAL_API_KEY=
