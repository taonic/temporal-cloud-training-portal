# Copy to .env and fill in from the "Connection details" block at the top of any
# session page in the training portal. Real environment variables take
# precedence, so you can still override any of these per-terminal.
#
# Not needed at all if you run against a local dev server:
#   temporal server start-dev
#   dotnet run -- worker --local

# The NAMESPACE endpoint, e.g. training-tao.bvmon.tmprl.cloud:7233
TEMPORAL_ADDRESS=

# <namespace>.<account>, e.g. training-tao.bvmon
TEMPORAL_NAMESPACE=

# The Worker's own credential. From Lab 2 onward this should be the
# service-account key, which Lab 2 writes here for you:
#
#   cd labs && terraform output -raw worker_api_key
#
# Before you have built that, your personal key from Lab 1 works. Either
# way the namespace must have API key auth enabled, which the Lab 1
# Terraform sets with api_key_auth = true.
TEMPORAL_API_KEY=
